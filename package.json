{
  "name": "agent-gates",
  "version": "0.1.0",
  "description": "Signale, dans de la matière externe, le texte qui se fait passer pour une instruction adressée à l'agent qui le lit. Il signale, il ne nettoie jamais.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-gates": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test test/bench.test.ts",
    "typecheck": "tsc --noEmit",
    "chaos": "node test/chaos.ts"
  },
  "keywords": [
    "prompt-injection",
    "agent-security",
    "guardrail",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sandy Ratovondrahety",
  "repository": {
    "type": "git",
    "url": "https://github.com/DynasR/agent-gates.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
